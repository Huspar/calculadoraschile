    <main class="flex-grow pt-24 pb-16 px-4 sm:px-6 lg:px-8">
        <article class="max-w-3xl mx-auto">

            <!-- Breadcrumb -->
            <nav class="flex items-center gap-2 text-xs text-slate-500 mb-8">
                <a href="/" class="hover:text-blue-400 transition-colors">Inicio</a>
